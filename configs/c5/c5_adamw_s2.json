{
  "data": {
    "batch_size": 128,
    "n_tasks": 200,
    "name": "permuted_mnist",
    "root": "data"
  },
  "device": "auto",
  "model": {
    "activation": "relu",
    "hidden_dims": [
      500,
      500,
      500
    ],
    "init": "kaiming_uniform"
  },
  "notes": "C5 optimizer arm adamw (protocol B.3).",
  "optim": {
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "lr": 0.001,
    "name": "adamw",
    "weight_decay": 0.01
  },
  "probe": {
    "intra_task_probe_every": 25,
    "intra_task_probe_reference": false
  },
  "run_id": "c5_adamw_s2",
  "seed": 2
}
